      "name": "Account Ingestion",
      "description": {
        "content": "Endpoints for sending events and traits tied to company accounts.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4bec6f90-9d51-4db5-a060-528d1ebc0dd1",
          "name": "Send account-level batch events and traits",
          "request": {
            "name": "Send account-level batch events and traits",
            "description": {
              "content": "Ingests a batch of identify calls (traits) and/or events associated with a company account rather than an individual visitor. Each request must include either an `account_id` or `domain`. Koala will create a new Account automatically if the domain has not been tracked before. Use the optional `group_id` inside each identify to disambiguate multiple tenants sharing the same domain.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                "batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "{{publicApiKey}}",
                  "key": "publicApiKey",
                  "description": "Your Koala workspace public API key"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "4d2bbdfd-15e0-4392-8435-7d668122cb1a",
              "name": "Batch accepted",
